{
  "name": "my-pi-setup",
  "version": "1.0.0",
  "description": "Pi extensions, skills, and a GitHub Dark theme.",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "acorn": "^8.17.0",
    "firecrawl": "^4.30.0",
    "effect": "4.0.0-rc.116",
    "@effect/platform-node": "4.0.0-rc.116",
    "@anthropic-ai/claude-agent-sdk": "0.3.278"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "@earendil-works/pi-ai": "0.82.0",
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@earendil-works/pi-tui": "0.82.0",
    "typebox": "1.3.6",
    "@effect/vitest": "4.0.0-rc.116",
    "vitest": "5.0.1",
    "oxlint": "1.83.0"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write \"extensions/**/*.{ts,cjs}\" \"scripts/**/*.mjs\" \"*.json\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,cjs}\" \"scripts/**/*.mjs\" \"*.json\"",
    "test": "node scripts/run-tests.mjs && vitest run extensions/file-search/index.spec.ts",
    "lint": "oxlint --deny-warnings extensions scripts",
    "test:live": "node scripts/run-tests.mjs --live",
    "test:install": "node scripts/test-install.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "extensions/ask-user/index.ts",
      "extensions/background-terminals/index.ts",
      "extensions/copy-all/index.ts",
      "extensions/deferred-tools/index.ts",
      "extensions/file-search/index.ts",
      "extensions/firecrawl-search/index.ts",
      "extensions/git-info/index.ts",
      "extensions/model-info/index.ts",
      "extensions/spark-strict-tools/index.ts",
      "extensions/subagents/index.ts",
      "extensions/summaries/index.ts",
      "extensions/ui-customization/index.ts",
      "extensions/workflows/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "files": [
    "extensions/**/*.ts",
    "extensions/**/*.cjs",
    "!extensions/**/*.test.ts",
    "!extensions/**/*.spec.ts",
    "skills",
    "themes",
    "SETUP.md",
    "assets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aquitano/my-pi-setup.git"
  },
  "homepage": "https://github.com/Aquitano/my-pi-setup#readme",
  "bugs": {
    "url": "https://github.com/Aquitano/my-pi-setup/issues"
  }
}
